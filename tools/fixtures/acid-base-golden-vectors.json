{
  "version": 1,
  "note": "Shared parity vectors for the acid-base analyzer. JS (web/src/lib/acidBaseEngine.js) and Swift (ios/Sources/Calc/AcidBaseEngine.swift) must both pass every case. Expected values were worked by hand from the rules (Brandis 9.3 bedside rules, delta ratio 3.3), not captured from the engine. 'expect' fields are checked only when present; flagsInclude/flagsExclude and disordersExact are set comparisons.",
  "cases": [
    { "name": "Normal gas",
      "input": { "ph": 7.40, "paco2": 40, "hco3": 24 },
      "expect": { "status": "ok", "phStatus": "normal", "primary": "normal", "disordersExact": [], "flagsExact": [] } },
    { "name": "Brandis rule 5 example: HCO3 14, PaCO2 30 → appropriate (expected 29)",
      "input": { "ph": 7.29, "paco2": 30, "hco3": 14 },
      "expect": { "phStatus": "acidemia", "primary": "metabolic_acidosis", "compRule": "winters", "compKey": "appropriate", "expectedCenter": 29, "expectedLo": 27, "expectedHi": 31, "disordersExact": ["metabolic_acidosis"], "flagsInclude": ["enter_electrolytes_for_gap"] } },
    { "name": "Brandis rule 5 example: HCO3 14, PaCO2 45 → plus respiratory acidosis",
      "input": { "ph": 7.12, "paco2": 45, "hco3": 14 },
      "expect": { "primary": "metabolic_acidosis", "compKey": "plus_respiratory_acidosis", "disordersExact": ["metabolic_acidosis", "respiratory_acidosis"] } },
    { "name": "Normal pH, PaCO2 22, HCO3 12: below the chronic respiratory alkalosis range (13-17) → mixed",
      "input": { "ph": 7.36, "paco2": 22, "hco3": 12, "chronicity": "unknown" },
      "expect": { "phStatus": "normal", "primary": "metabolic_acidosis_with_respiratory_alkalosis" } },
    { "name": "Metabolic acidosis, acidemic, PaCO2 low for Winter's → plus respiratory alkalosis",
      "input": { "ph": 7.32, "paco2": 20, "hco3": 10 },
      "expect": { "primary": "metabolic_acidosis", "compKey": "plus_respiratory_alkalosis", "expectedCenter": 23, "disordersExact": ["metabolic_acidosis", "respiratory_alkalosis"] } },
    { "name": "Metabolic alkalosis, HCO3 36, PaCO2 45 → appropriate (expected 45.2 ± 5)",
      "input": { "ph": 7.53, "paco2": 45, "hco3": 36 },
      "expect": { "phStatus": "alkalemia", "primary": "metabolic_alkalosis", "compRule": "met_alk", "compKey": "appropriate", "expectedCenter": 45.2, "expectedLo": 40.2, "expectedHi": 50.2 } },
    { "name": "Metabolic alkalosis, HCO3 34, PaCO2 35 → plus respiratory alkalosis",
      "input": { "ph": 7.61, "paco2": 35, "hco3": 34 },
      "expect": { "primary": "metabolic_alkalosis", "compKey": "plus_respiratory_alkalosis", "expectedCenter": 43.8, "disordersExact": ["metabolic_alkalosis", "respiratory_alkalosis"] } },
    { "name": "Brandis rule 1 example: acute respiratory acidosis, PaCO2 60, HCO3 31 → plus metabolic alkalosis",
      "input": { "ph": 7.34, "paco2": 60, "hco3": 31, "chronicity": "acute" },
      "expect": { "phStatus": "acidemia", "primary": "respiratory_acidosis", "compRule": "resp_acid", "compKey": "plus_metabolic_alkalosis", "acuteCenter": 26, "chronicCenter": 32, "disordersExact": ["respiratory_acidosis", "metabolic_alkalosis"] } },
    { "name": "Brandis rule 2 example: chronic respiratory acidosis, PaCO2 60, HCO3 31 → appropriate",
      "input": { "ph": 7.34, "paco2": 60, "hco3": 31, "chronicity": "chronic" },
      "expect": { "primary": "respiratory_acidosis", "compKey": "appropriate", "chronicCenter": 32, "disordersExact": ["respiratory_acidosis"] } },
    { "name": "Same gas, chronicity unknown → fits chronic",
      "input": { "ph": 7.34, "paco2": 60, "hco3": 31 },
      "expect": { "compKey": "fits_chronic" } },
    { "name": "Respiratory acidosis, unknown, HCO3 between acute and chronic",
      "input": { "ph": 7.25, "paco2": 70, "hco3": 30 },
      "expect": { "primary": "respiratory_acidosis", "compKey": "between_acute_and_chronic", "acuteCenter": 27, "chronicCenter": 36 } },
    { "name": "Respiratory acidosis, chronic selected, HCO3 below chronic range → plus metabolic acidosis",
      "input": { "ph": 7.25, "paco2": 70, "hco3": 30, "chronicity": "chronic" },
      "expect": { "compKey": "plus_metabolic_acidosis", "disordersExact": ["respiratory_acidosis", "metabolic_acidosis"] } },
    { "name": "Small PaCO2 rise: acute and chronic ranges overlap",
      "input": { "ph": 7.34, "paco2": 52, "hco3": 27 },
      "expect": { "primary": "respiratory_acidosis", "compKey": "acute_or_chronic", "acuteCenter": 25.2, "chronicCenter": 28.8 } },
    { "name": "Acute respiratory alkalosis, PaCO2 25, HCO3 21 → fits acute",
      "input": { "ph": 7.55, "paco2": 25, "hco3": 21 },
      "expect": { "phStatus": "alkalemia", "primary": "respiratory_alkalosis", "compRule": "resp_alk", "compKey": "fits_acute", "acuteCenter": 21, "chronicCenter": 16.5 } },
    { "name": "Respiratory alkalosis, acute selected, HCO3 16 at PaCO2 20 → plus metabolic acidosis",
      "input": { "ph": 7.53, "paco2": 20, "hco3": 16, "chronicity": "acute" },
      "expect": { "compKey": "plus_metabolic_acidosis", "acuteCenter": 20, "disordersExact": ["respiratory_alkalosis", "metabolic_acidosis"] } },
    { "name": "Combined acidosis (PaCO2 high, HCO3 low)",
      "input": { "ph": 7.14, "paco2": 55, "hco3": 18 },
      "expect": { "primary": "combined_acidosis", "compensation": null, "disordersExact": ["respiratory_acidosis", "metabolic_acidosis"] } },
    { "name": "Combined alkalosis (PaCO2 low, HCO3 high)",
      "input": { "ph": 7.62, "paco2": 30, "hco3": 30 },
      "expect": { "primary": "combined_alkalosis", "compensation": null, "disordersExact": ["respiratory_alkalosis", "metabolic_alkalosis"] } },
    { "name": "Normal pH, both high, fits chronic respiratory acidosis",
      "input": { "ph": 7.37, "paco2": 50, "hco3": 28 },
      "expect": { "phStatus": "normal", "primary": "compensated_chronic_respiratory_acidosis", "disordersExact": ["respiratory_acidosis"] } },
    { "name": "Normal pH, both high, HCO3 above chronic range → respiratory acidosis + metabolic alkalosis",
      "input": { "ph": 7.40, "paco2": 55, "hco3": 33 },
      "expect": { "primary": "respiratory_acidosis_with_metabolic_alkalosis", "disordersExact": ["respiratory_acidosis", "metabolic_alkalosis"] } },
    { "name": "Normal pH, both low, fits chronic respiratory alkalosis",
      "input": { "ph": 7.42, "paco2": 30, "hco3": 19 },
      "expect": { "primary": "compensated_chronic_respiratory_alkalosis", "disordersExact": ["respiratory_alkalosis"] } },
    { "name": "Normal pH, both low, HCO3 below chronic range → metabolic acidosis + respiratory alkalosis (salicylate pattern)",
      "input": { "ph": 7.37, "paco2": 27, "hco3": 15 },
      "expect": { "primary": "metabolic_acidosis_with_respiratory_alkalosis", "disordersExact": ["metabolic_acidosis", "respiratory_alkalosis"] } },
    { "name": "Mild acidemia, both values inside range → larger scaled deviation (respiratory)",
      "input": { "ph": 7.34, "paco2": 44, "hco3": 23 },
      "expect": { "phStatus": "acidemia", "primary": "respiratory_acidosis" } },
    { "name": "Values that do not fit Henderson-Hasselbalch",
      "input": { "ph": 7.40, "paco2": 40, "hco3": 15 },
      "expect": { "flagsInclude": ["hh_inconsistent"], "hhCalculated": 7.2 } },
    { "name": "HAGMA, no albumin: AG 22, delta ratio 1.0",
      "input": { "ph": 7.29, "paco2": 30, "hco3": 14, "na": 140, "cl": 104 },
      "expect": { "agValue": 22, "agUsed": 22, "agKey": "high", "deltaRatio": 1.0, "deltaKey": "hagma", "flagsInclude": ["albumin_not_entered"], "differentialsExact": ["hagma"] } },
    { "name": "Albumin 2 unmasks the gap: AG 16 → corrected 21, delta 0.9",
      "input": { "ph": 7.29, "paco2": 30, "hco3": 14, "na": 140, "cl": 110, "albumin": 2 },
      "expect": { "agValue": 16, "agCorrected": 21, "agUsed": 21, "deltaRatio": 0.9, "deltaKey": "hagma", "flagsExclude": ["albumin_not_entered"] } },
    { "name": "Same electrolytes without albumin read as combined HAGMA + NAGMA (delta 0.4)",
      "input": { "ph": 7.29, "paco2": 30, "hco3": 14, "na": 140, "cl": 110 },
      "expect": { "agUsed": 16, "deltaRatio": 0.4, "deltaKey": "hagma_plus_nagma", "differentialsExact": ["hagma", "nagma"] } },
    { "name": "Normal anion gap acidosis: AG 11, delta < 0.4",
      "input": { "ph": 7.29, "paco2": 30, "hco3": 14, "na": 140, "cl": 115, "albumin": 4 },
      "expect": { "agUsed": 11, "agKey": "normal", "deltaRatio": -0.1, "deltaKey": "nagma", "differentialsExact": ["nagma"] } },
    { "name": "HAGMA with high delta ratio (3.0) → concurrent metabolic alkalosis or chronic respiratory acidosis",
      "input": { "ph": 7.33, "paco2": 35, "hco3": 18, "na": 140, "cl": 92, "albumin": 4 },
      "expect": { "primary": "metabolic_acidosis", "compKey": "appropriate", "agUsed": 30, "deltaRatio": 3.0, "deltaKey": "hagma_plus_high_hco3" } },
    { "name": "Normal pH and gas, AG 22 → hidden acidosis likely",
      "input": { "ph": 7.40, "paco2": 40, "hco3": 24, "na": 140, "cl": 94, "albumin": 4 },
      "expect": { "primary": "normal", "agUsed": 22, "flagsInclude": ["hidden_acidosis_likely"], "differentialsExact": ["hagma"] } },
    { "name": "Normal pH, AG 34 → hidden acidosis definite",
      "input": { "ph": 7.42, "paco2": 41, "hco3": 26, "na": 145, "cl": 85, "albumin": 4 },
      "expect": { "agUsed": 34, "flagsInclude": ["hidden_acidosis_definite"], "flagsExclude": ["hidden_acidosis_likely"] } },
    { "name": "Missing HCO3 → incomplete",
      "input": { "ph": 7.30, "paco2": 30 },
      "expect": { "status": "incomplete" } },
    { "name": "pH out of range → error",
      "input": { "ph": 9.0, "paco2": 40, "hco3": 24 },
      "expect": { "status": "error", "error": "out_of_range_ph" } }
  ]
}
