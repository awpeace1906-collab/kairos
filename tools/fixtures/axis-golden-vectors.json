{
  "version": 2,
  "note": "Shared parity vectors. JS and Swift engines must both pass every case. 'expect' fields are checked only when present. v2 (2026-09-26): pediatric bands switched to the AHA/ACCF/HRS 2009 Part III table with adult limits from 16 years; eight age-band cases added.",
  "cases": [
    { "name": "PRT: standard printout, borderline LAD, borderline QRS-T",
      "input": { "mode": "prt", "prt": { "text": "P-R-T axes 54 -42 38" } },
      "expect": { "status": "ok", "qrsAxis": -42, "qrsKey": "lad_borderline", "pKey": "normal", "tKey": "normal", "qrsTAngle": 80, "qrsTKey": "borderline", "flagsExact": [] } },
    { "name": "PRT: full pasted header containing other intervals",
      "input": { "mode": "prt", "prt": { "text": "Vent. rate 72 BPM PR interval 160 ms QRS duration 88 ms QT/QTc 380/410 ms P-R-T axes 54 -42 38" } },
      "expect": { "status": "ok", "pAxis": 54, "qrsAxis": -42, "tAxis": 38 } },
    { "name": "PRT: named tokens",
      "input": { "mode": "prt", "prt": { "text": "P 54 QRS -42 T 38" } },
      "expect": { "status": "ok", "pAxis": 54, "qrsAxis": -42, "tAxis": 38 } },
    { "name": "PRT: slash separated with unicode minus",
      "input": { "mode": "prt", "prt": { "text": "54/\u221242/38" } },
      "expect": { "status": "ok", "qrsAxis": -42 } },
    { "name": "PRT: marked LAD triggers LAFB checklist and high-risk QRS-T",
      "input": { "mode": "prt", "prt": { "text": "54 -60 40" } },
      "expect": { "status": "ok", "qrsKey": "lad_marked", "qrsTAngle": 100, "qrsTKey": "abnormal", "flagsInclude": ["lafb_checklist", "qrs_t_angle_high_risk"] } },
    { "name": "PRT: absent P axis (AF)",
      "input": { "mode": "prt", "prt": { "text": "*** 72 45" } },
      "expect": { "status": "ok", "pKey": "absent", "qrsKey": "normal", "qrsTAngle": 27, "qrsTKey": "normal", "flagsInclude": ["check_rhythm_no_p"] } },
    { "name": "PRT: two values after 'axes' => P assumed absent",
      "input": { "mode": "prt", "prt": { "text": "P-R-T axes  72 45" } },
      "expect": { "status": "ok", "pKey": "absent", "qrsAxis": 72, "warningsInclude": ["p_assumed_absent"] } },
    { "name": "PRT: QRS-T angle wraps through 180",
      "input": { "mode": "prt", "prt": { "text": "60 -170 170" } },
      "expect": { "status": "ok", "qrsKey": "extreme", "qrsTAngle": 20, "qrsTKey": "normal", "differential": "extreme" } },
    { "name": "PRT: limb lead reversal vs dextrocardia combo",
      "input": { "mode": "prt", "prt": { "text": "-120 150 -140" } },
      "expect": { "status": "ok", "pKey": "negative_lead_I", "qrsKey": "rad", "flagsInclude": ["limb_lead_reversal_vs_dextrocardia"] } },
    { "name": "PRT: vertical P axis",
      "input": { "mode": "prt", "prt": { "text": "80 85 50" } },
      "expect": { "status": "ok", "pKey": "vertical", "qrsKey": "normal" } },
    { "name": "PRT: superior P axis (low atrial)",
      "input": { "mode": "prt", "prt": { "text": "-40 60 45" } },
      "expect": { "status": "ok", "pKey": "superior" } },
    { "name": "PRT: LBBB suppresses QRS-T cutoffs and LAFB",
      "input": { "mode": "prt", "prt": { "text": "50 -45 120" }, "modifiers": { "lbbb": true } },
      "expect": { "status": "ok", "qrsKey": "lad_marked", "qrsTAngle": 165, "qrsTKey": "secondary_repolarization", "flagsExclude": ["lafb_checklist", "qrs_t_angle_high_risk"] } },
    { "name": "PRT: machine prints 0-359 style (270 == -90)",
      "input": { "mode": "prt", "prt": { "p": 50, "qrs": 270, "t": 40 } },
      "expect": { "status": "ok", "qrsAxis": -90, "qrsKey": "lad_marked" } },
    { "name": "PRT: garbage input",
      "input": { "mode": "prt", "prt": { "text": "axes" } },
      "expect": { "status": "error", "error": "unparseable" } },

    { "name": "Boundary -30 is normal", "input": { "mode": "prt", "prt": { "qrs": -30 } }, "expect": { "qrsKey": "normal" } },
    { "name": "Boundary -31 is borderline LAD", "input": { "mode": "prt", "prt": { "qrs": -31 } }, "expect": { "qrsKey": "lad_borderline" } },
    { "name": "Boundary -44 borderline", "input": { "mode": "prt", "prt": { "qrs": -44 } }, "expect": { "qrsKey": "lad_borderline" } },
    { "name": "Boundary -45 marked", "input": { "mode": "prt", "prt": { "qrs": -45 } }, "expect": { "qrsKey": "lad_marked" } },
    { "name": "Boundary -90 marked LAD", "input": { "mode": "prt", "prt": { "qrs": -90 } }, "expect": { "qrsKey": "lad_marked" } },
    { "name": "Boundary -91 extreme", "input": { "mode": "prt", "prt": { "qrs": -91 } }, "expect": { "qrsKey": "extreme" } },
    { "name": "Boundary +90 normal", "input": { "mode": "prt", "prt": { "qrs": 90 } }, "expect": { "qrsKey": "normal" } },
    { "name": "Boundary +91 RAD", "input": { "mode": "prt", "prt": { "qrs": 91 } }, "expect": { "qrsKey": "rad", "flagsInclude": ["lpfb_checklist"] } },
    { "name": "Boundary 180 RAD", "input": { "mode": "prt", "prt": { "qrs": 180 } }, "expect": { "qrsKey": "rad" } },

    { "name": "Peds: 5 days, +150 normal for age", "input": { "mode": "prt", "prt": { "qrs": 150 }, "ageDays": 5 }, "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Peds: 2 days, -170 (=190) normal for age", "input": { "mode": "prt", "prt": { "qrs": -170 }, "ageDays": 2 }, "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Peds: 2 months, +150 rightward", "input": { "mode": "prt", "prt": { "qrs": 150 }, "ageDays": 60 }, "expect": { "qrsKey": "rightward_for_age" } },
    { "name": "Peds: 6 months, -100 leftward + infant superior axis flag", "input": { "mode": "prt", "prt": { "qrs": -100 }, "ageDays": 180 }, "expect": { "qrsKey": "leftward_for_age", "flagsInclude": ["infant_superior_axis"] } },
    { "name": "Peds: 10 years, +115 normal for age (would be RAD in adult)", "input": { "mode": "prt", "prt": { "qrs": 115 }, "ageDays": 3650 }, "expect": { "qrsKey": "normal_for_age", "differential": null } },

    { "name": "Quadrant: I+ aVF+ normal", "input": { "mode": "polarity", "polarities": { "I": "pos", "aVF": "pos" } }, "expect": { "status": "ok", "qrsKey": "normal", "range": [1, 89] } },
    { "name": "Quadrant: I+ aVF- spans, add lead II", "input": { "mode": "polarity", "polarities": { "I": "pos", "aVF": "neg" } }, "expect": { "status": "ok", "qrsKey": "spans", "warningsInclude": ["add_lead_II"] } },
    { "name": "Quadrant: I- aVF+ RAD", "input": { "mode": "polarity", "polarities": { "I": "neg", "aVF": "pos" } }, "expect": { "qrsKey": "rad", "range": [91, 179] } },
    { "name": "Quadrant: I- aVF- extreme", "input": { "mode": "polarity", "polarities": { "I": "neg", "aVF": "neg" } }, "expect": { "qrsKey": "extreme", "range": [-179, -91] } },
    { "name": "Quadrant: I iso aVF+ = +90", "input": { "mode": "polarity", "polarities": { "I": "iso", "aVF": "pos" } }, "expect": { "qrsAxis": 90, "qrsKey": "normal" } },
    { "name": "Three-lead: I+ II- aVF- pathological LAD", "input": { "mode": "polarity", "polarities": { "I": "pos", "II": "neg", "aVF": "neg" } }, "expect": { "range": [-89, -31] } },
    { "name": "Three-lead: I+ II iso aVF- = -30 (physiologic)", "input": { "mode": "polarity", "polarities": { "I": "pos", "II": "iso", "aVF": "neg" } }, "expect": { "qrsAxis": -30, "qrsKey": "normal" } },
    { "name": "Three-lead: impossible combination", "input": { "mode": "polarity", "polarities": { "I": "pos", "II": "neg", "aVF": "pos" } }, "expect": { "status": "inconsistent" } },
    { "name": "Iso lead only: ambiguous", "input": { "mode": "polarity", "polarities": { "I": "iso" } }, "expect": { "status": "ambiguous" } },
    { "name": "LITFL ex1: aVL iso, I II aVF + => +60", "input": { "mode": "polarity", "polarities": { "aVL": "iso", "I": "pos", "II": "pos", "aVF": "pos" } }, "expect": { "qrsAxis": 60 } },
    { "name": "LITFL ex2: II iso, III aVF +, aVL - => +150", "input": { "mode": "polarity", "polarities": { "II": "iso", "III": "pos", "aVF": "pos", "aVL": "neg" } }, "expect": { "qrsAxis": 150, "qrsKey": "rad" } },
    { "name": "LITFL ex4: aVL iso, aVR +, II - => -120", "input": { "mode": "polarity", "polarities": { "aVL": "iso", "aVR": "pos", "II": "neg" } }, "expect": { "qrsAxis": -120, "qrsKey": "extreme" } },

    { "name": "Precise: naive-atan2 trap, true -33 (naive reads -29.4 = normal)", "input": { "mode": "amplitudes", "amplitudes": { "I": 8.39, "aVF": -4.72 } }, "expect": { "status": "ok", "qrsAxis": -33, "qrsKey": "lad_borderline" } },
    { "name": "Precise: I and II => +110", "input": { "mode": "amplitudes", "amplitudes": { "I": -3.42, "II": 6.43 } }, "expect": { "qrsAxis": 110, "qrsKey": "rad" } },
    { "name": "Precise: all six leads => -120", "input": { "mode": "amplitudes", "amplitudes": { "I": -5, "II": -10, "III": -5, "aVR": 7.5, "aVL": 0, "aVF": -7.5 } }, "expect": { "qrsAxis": -120, "qrsKey": "extreme", "warningsExclude": ["einthoven_mismatch", "goldberger_mismatch"] } },
    { "name": "Precise: Einthoven mismatch warns", "input": { "mode": "amplitudes", "amplitudes": { "I": 5, "II": 8, "III": 6 } }, "expect": { "status": "ok", "warningsInclude": ["einthoven_mismatch"] } },
    { "name": "Precise: all zero => indeterminate", "input": { "mode": "amplitudes", "amplitudes": { "I": 0, "aVF": 0 } }, "expect": { "status": "indeterminate" } },
    { "name": "Precise: one lead only", "input": { "mode": "amplitudes", "amplitudes": { "I": 5 } }, "expect": { "status": "need_two_leads" } },
    { "name": "Peds: 20 days, +185 normal for age (AHA neonate +30 to +190)",
      "input": { "mode": "prt", "prt": { "qrs": 185 }, "ageDays": 20 },
      "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Peds: 4 years, +110 rightward for age (AHA 1-5 y +5 to +100)",
      "input": { "mode": "prt", "prt": { "qrs": 110 }, "ageDays": 1460 },
      "expect": { "qrsKey": "rightward_for_age" } },
    { "name": "Peds: 6 years, +130 normal for age (AHA 5-8 y 0 to +140)",
      "input": { "mode": "prt", "prt": { "qrs": 130 }, "ageDays": 2190 },
      "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Peds: 10 years, +10 normal for age (AHA 8-16 y lower limit 0)",
      "input": { "mode": "prt", "prt": { "qrs": 10 }, "ageDays": 3650 },
      "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Peds: 10 years, -10 leftward for age",
      "input": { "mode": "prt", "prt": { "qrs": -10 }, "ageDays": 3650 },
      "expect": { "qrsKey": "leftward_for_age" } },
    { "name": "Peds: 15 years, +110 normal for age",
      "input": { "mode": "prt", "prt": { "qrs": 110 }, "ageDays": 5475 },
      "expect": { "qrsKey": "normal_for_age" } },
    { "name": "Age 16 years uses adult limits: +110 is RAD",
      "input": { "mode": "prt", "prt": { "qrs": 110 }, "ageDays": 5840 },
      "expect": { "qrsKey": "rad" } },
    { "name": "Age 17 years uses adult limits: +100 is RAD",
      "input": { "mode": "prt", "prt": { "qrs": 100 }, "ageDays": 6205 },
      "expect": { "qrsKey": "rad" } }
  ]
}
