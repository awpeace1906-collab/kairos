{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/common.schema.json",
  "title": "Kairos shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable unique identifier, kebab-case, never reused."
    },
    "section": {
      "type": "string",
      "enum": [
        "Procedures",
        "Calculators",
        "Drug & Dosing Cards",
        "Reference Library",
        "Peds Module"
      ]
    },
    "contentType": {
      "type": "string",
      "enum": [
        "calculator",
        "procedure",
        "drug-card",
        "anesthesia-drug-card",
        "reference",
        "peds-tool"
      ]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewTier": {
      "description": "Review cadence bucket. See content/config/tiers.json.",
      "oneOf": [
        {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        {
          "type": "string",
          "enum": [
            "stable"
          ]
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 3,
      "description": "Citation: PMID, DOI, guideline name + year, or 'Author et al. Journal Year'."
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "change"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "change": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "flag": {
      "type": "string",
      "enum": [
        "verify-coefficients",
        "verify-against-mdcalc",
        "needs-primary-source",
        "licensing-sensitive",
        "institution-specific",
        "stub"
      ]
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewBox",
        "shapes"
      ],
      "description": "An original, declarative vector illustration. The shapes are vector so they render natively on both clients (web SVG, iOS SwiftUI Canvas), stay offline-first and tiny, and theme themselves via semantic color tokens — the same architectural pattern as the calculator `plot` field. An optional `image` adds a raster background beneath them for the cases where real anatomy teaches better than a schematic; it is restricted to public-domain and permissive licenses, shipped offline, and checksum-verified, so the no-third-party-licensing-problems property still holds.",
      "properties": {
        "title": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "description": "Rendered under the figure. Carries the teaching point, not a restatement of the labels."
        },
        "viewBox": {
          "type": "array",
          "description": "[minX, minY, width, height] — the drawing's own coordinate space; both renderers scale to fit.",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "image": {
          "description": "Optional raster BACKGROUND beneath the vector shapes — a public-domain or permissively licensed anatomical plate, for example. The image is drawn in viewBox units at `at` with its natural `width` x `height`, so the overlay shapes are authored in the image's own pixel coordinates and stay registered to the anatomy on every screen. The viewBox then acts as a crop window onto it. When an image is present, both clients render the figure in the light palette regardless of theme: plates are ink on white, and inverting an engraving for dark mode makes it unreadable.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src",
            "width",
            "height",
            "credit",
            "license"
          ],
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^assets/[a-z0-9/_.-]+\\.(png|jpg|jpeg|webp)$",
              "description": "Path relative to the content root. Must live under assets/ so the manifest lists it and both clients ship it offline."
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Top-left placement in viewBox units. Defaults to [0, 0]."
            },
            "credit": {
              "type": "string",
              "minLength": 5,
              "description": "Rendered with the figure. Required even for public-domain material: provenance matters in a clinical reference, whatever the license demands."
            },
            "license": {
              "type": "string",
              "enum": [
                "public-domain",
                "CC0-1.0",
                "CC-BY-4.0",
                "CC-BY-3.0"
              ],
              "description": "Share-alike licenses (CC BY-SA) are deliberately excluded: an overlay is a derivative work, and share-alike would bind the figure — and arguably the module around it — to the same license."
            },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "SHA-1 of the file as published at sourceUrl. validate.mjs checks the file on disk against it, so a swapped or corrupted plate fails CI."
            }
          }
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "path",
                  "line",
                  "polyline",
                  "rect",
                  "circle",
                  "ellipse",
                  "arrow",
                  "text"
                ]
              },
              "d": {
                "type": "string",
                "description": "kind=path: SVG path data. Supported commands: M/m L/l H/h V/v C/c Q/q Z/z (no arcs — approximate with curves)."
              },
              "points": {
                "type": "array",
                "description": "kind=polyline: [[x,y], ...]",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "r": {
                "type": "number"
              },
              "rx": {
                "type": "number"
              },
              "ry": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "fontSize": {
                "type": "number",
                "default": 11
              },
              "anchor": {
                "type": "string",
                "enum": [
                  "start",
                  "middle",
                  "end"
                ],
                "default": "start"
              },
              "weight": {
                "type": "string",
                "enum": [
                  "regular",
                  "bold"
                ],
                "default": "regular"
              },
              "fill": {
                "$ref": "common.schema.json#/$defs/diagramColor"
              },
              "stroke": {
                "$ref": "common.schema.json#/$defs/diagramColor"
              },
              "strokeWidth": {
                "type": "number",
                "default": 1.5
              },
              "dash": {
                "type": "boolean",
                "default": false,
                "description": "Dashed stroke — conventionally 'a plane/landmark you infer rather than see'."
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "diagramColor": {
      "type": "string",
      "description": "Semantic token, never a literal hex — each client maps these to its own light/dark palette so a diagram is legible in both themes.",
      "enum": [
        "outline",
        "surface",
        "tissue",
        "bone",
        "lumen",
        "muscle",
        "vessel",
        "accent",
        "danger",
        "warning",
        "good",
        "muted",
        "text"
      ]
    },
    "listItem": {
      "description": "One entry in a list. A plain string is a leaf. The object form adds children, so a numbered step can carry its own sub-steps instead of flattening them into a paragraph. Strings and objects may be mixed in the same list, and every existing flat list stays valid. Nesting is capped at 3 levels by a validate.mjs invariant — deeper than that the content wants a table or its own section, not more indentation.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "ordered": {
              "type": "boolean",
              "default": false,
              "description": "Number this item's CHILDREN. Independent of the parent list's own numbering, so an unordered list can hold an ordered sub-list and vice versa."
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/listItem"
              }
            }
          }
        }
      ]
    },
    "nestedList": {
      "description": "A list plus its own numbering flag, for places that hold exactly one list (a procedure step's sub-steps).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "ordered": {
          "type": "boolean",
          "default": false,
          "description": "Render as a numbered list. Sub-steps of a numbered procedure step usually want this."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/listItem"
          }
        }
      }
    },
    "recordMeta": {
      "type": "object",
      "description": "Fields every content module carries.",
      "required": [
        "id",
        "section",
        "category",
        "title",
        "content_version",
        "contentType"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "section": {
          "$ref": "common.schema.json#/$defs/section"
        },
        "category": {
          "type": "string",
          "minLength": 2
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Clinician-facing synonyms / concepts — what someone types under pressure ('chest pain', not 'HEART Score'). Ranked below title, above keywords."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Abbreviations, alternate names, common misspellings ('GBS' for Glasgow-Blatchford)."
        },
        "settingEmphasis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Care-setting ids (from config/settings.json) this module is most relevant to, most-relevant first. Drives render-time reordering when a setting lens is active. Absent = neutral (never reordered). A LENS, not a fork — never duplicate a module per setting."
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adult",
              "peds",
              "neonate"
            ]
          },
          "uniqueItems": true,
          "description": "Patient population(s) this module is for. Absent = adult (the default clinical context). The peds lens floats modules whose audience includes 'peds' or 'neonate' to the top of any list; it never hides anything."
        },
        "crossListIn": {
          "type": "array",
          "description": "Additional {section, category} placements. The module's own section/category is its home; each entry here makes it ALSO appear when browsing that section (flagged as cross-listed). For a peds tool that belongs beside its adult counterpart — e.g. the pediatric appendicitis scores under Calculators / GI. Not a move, not a duplicate: one module, one route.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "category"
            ],
            "properties": {
              "section": {
                "$ref": "common.schema.json#/$defs/section"
              },
              "category": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        "contentType": {
          "$ref": "common.schema.json#/$defs/contentType"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "last_reviewed": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "next_review_due": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "review_tier": {
          "$ref": "common.schema.json#/$defs/reviewTier"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "changelog": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/changelogEntry"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/flag"
          }
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-z0-9/_-]*$",
          "description": "In-app deep link. Generated if omitted."
        }
      }
    },
    "tieredReviewRequired": {
      "description": "If review_tier is 1, 2, or 3, the review dates and sources are mandatory.",
      "if": {
        "properties": {
          "review_tier": {
            "type": "integer"
          }
        },
        "required": [
          "review_tier"
        ]
      },
      "then": {
        "required": [
          "last_reviewed",
          "next_review_due",
          "sources",
          "review_tier"
        ]
      }
    }
  }
}
