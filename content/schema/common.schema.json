{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/common.schema.json",
  "title": "Kairos shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable unique identifier, kebab-case, never reused."
    },
    "section": {
      "type": "string",
      "enum": ["Procedures", "Calculators", "Drug & Dosing Cards", "Reference Library", "Peds Module"]
    },
    "contentType": {
      "type": "string",
      "enum": ["calculator", "procedure", "drug-card", "reference", "peds-tool"]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewTier": {
      "description": "Review cadence bucket. See content/config/tiers.json.",
      "oneOf": [
        { "type": "integer", "enum": [1, 2, 3] },
        { "type": "string", "enum": ["stable"] }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 3,
      "description": "Citation: PMID, DOI, guideline name + year, or 'Author et al. Journal Year'."
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "change"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "date": { "$ref": "common.schema.json#/$defs/isoDate" },
        "change": { "type": "string", "minLength": 3 }
      }
    },
    "flag": {
      "type": "string",
      "enum": [
        "verify-coefficients",
        "verify-against-mdcalc",
        "needs-primary-source",
        "licensing-sensitive",
        "institution-specific",
        "stub"
      ]
    },
    "recordMeta": {
      "type": "object",
      "description": "Fields every content module carries.",
      "required": ["id", "section", "category", "title", "content_version", "contentType"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "section": { "$ref": "common.schema.json#/$defs/section" },
        "category": { "type": "string", "minLength": 2 },
        "title": { "type": "string", "minLength": 2 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Clinician-facing synonyms / concepts — what someone types under pressure ('chest pain', not 'HEART Score'). Ranked below title, above keywords."
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Abbreviations, alternate names, common misspellings ('GBS' for Glasgow-Blatchford)."
        },
        "contentType": { "$ref": "common.schema.json#/$defs/contentType" },
        "content_version": { "type": "integer", "minimum": 1 },
        "last_reviewed": { "$ref": "common.schema.json#/$defs/isoDate" },
        "next_review_due": { "$ref": "common.schema.json#/$defs/isoDate" },
        "review_tier": { "$ref": "common.schema.json#/$defs/reviewTier" },
        "sources": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/source" } },
        "changelog": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/changelogEntry" } },
        "flags": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/flag" } },
        "route": {
          "type": "string",
          "pattern": "^/[a-z0-9/_-]*$",
          "description": "In-app deep link. Generated if omitted."
        }
      }
    },
    "tieredReviewRequired": {
      "description": "If review_tier is 1, 2, or 3, the review dates and sources are mandatory.",
      "if": {
        "properties": { "review_tier": { "type": "integer" } },
        "required": ["review_tier"]
      },
      "then": {
        "required": ["last_reviewed", "next_review_due", "sources", "review_tier"]
      }
    }
  }
}
