{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/procedure.schema.json",
  "title": "Kairos procedure guide module",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/recordMeta" },
    { "$ref": "common.schema.json#/$defs/tieredReviewRequired" }
  ],
  "unevaluatedProperties": false,
  "required": ["outputType", "purpose"],
  "properties": {
    "id": true, "section": true, "category": true, "title": true, "aliases": true, "tags": true, "keywords": true,
    "contentType": { "const": "procedure" },
    "content_version": true, "last_reviewed": true, "next_review_due": true,
    "review_tier": true, "sources": true, "changelog": true, "flags": true, "route": true,

    "purpose": { "type": "string", "minLength": 10 },
    "outputType": {
      "type": "string",
      "enum": ["decision-tree", "reference-checklist", "workflow"]
    },
    "crossLinks": {
      "description": "IDs of other modules this guide pulls from rather than duplicating (e.g. LA max dosing).",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "entryPrompt": { "type": "string" },
    "nodes": {
      "description": "Decision-tree nodes. Storyboarding the full branch logic is a spec-package TODO; this holds what exists.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["question", "step", "recommendation", "warning"] },
          "prompt": { "type": "string" },
          "body": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "next"],
              "properties": { "label": { "type": "string" }, "next": { "type": "string" } }
            }
          }
        }
      }
    },
    "checklist": { "type": "array", "items": { "type": "string" } },
    "noteTemplate": {
      "type": "string",
      "description": "Procedure-note template with {{placeholders}} filled from the tree walk."
    },
    "buildNote": { "type": "string" }
  }
}
