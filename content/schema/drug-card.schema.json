{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/drug-card.schema.json",
  "title": "Kairos drug / dosing card module",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/recordMeta" },
    { "$ref": "common.schema.json#/$defs/tieredReviewRequired" }
  ],
  "unevaluatedProperties": false,
  "required": ["purpose", "doses"],
  "properties": {
    "id": true, "section": true, "category": true, "title": true, "aliases": true, "tags": true, "keywords": true,
    "contentType": { "const": "drug-card" },
    "content_version": true, "last_reviewed": true, "next_review_due": true,
    "review_tier": true, "sources": true, "changelog": true, "flags": true, "route": true,

    "purpose": { "type": "string", "minLength": 10 },
    "population": { "type": "string", "enum": ["adult", "peds", "both"] },
    "weightBasis": {
      "type": "string",
      "enum": ["actual", "ideal", "adjusted", "lean"],
      "description": "Which body weight the per-kg rule uses. Doses are ALWAYS computed live from the exact value — never read from a zone."
    },
    "doses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indication", "route", "rule"],
        "properties": {
          "indication": { "type": "string" },
          "route": { "type": "string" },
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["perKg"],
            "properties": {
              "perKg": { "type": "number", "description": "mg/kg (or unit/kg) per dose." },
              "perKgHigh": { "type": "number", "description": "Upper bound when the dose is a per-kg range (perKg is the lower bound)." },
              "unit": { "type": "string", "default": "mg" },
              "maxDose": { "type": "number", "description": "Absolute per-dose cap." },
              "minDose": { "type": "number", "description": "Absolute per-dose floor (e.g. atropine 0.1 mg to avoid paradoxical bradycardia)." },
              "maxDoseUnit": { "type": "string" },
              "concentration": { "type": "string", "description": "e.g. '1:10,000 = 0.1 mg/mL' for a volume readout." },
              "mlPerUnit": { "type": "number" },
              "repeat": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "contraindications": { "type": "array", "items": { "type": "string" } },
    "reversal": { "type": "string" },
    "buildNote": { "type": "string" }
  }
}
