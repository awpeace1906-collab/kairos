{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/calculator.schema.json",
  "title": "Kairos calculator module",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/recordMeta"
    },
    {
      "$ref": "common.schema.json#/$defs/tieredReviewRequired"
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "builtin"
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "required": [
          "tool",
          "toolContent"
        ]
      }
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "engine",
    "purpose",
    "interpretation"
  ],
  "properties": {
    "id": true,
    "section": true,
    "category": true,
    "title": true,
    "aliases": true,
    "tags": true,
    "keywords": true,
    "settingEmphasis": true,
    "audience": true,
    "crossListIn": true,
    "contentType": {
      "const": "calculator"
    },
    "content_version": true,
    "last_reviewed": true,
    "next_review_due": true,
    "review_tier": true,
    "sources": true,
    "changelog": true,
    "flags": true,
    "route": true,
    "engine": {
      "type": "string",
      "enum": [
        "additive",
        "formula",
        "classification",
        "external",
        "builtin"
      ],
      "description": "additive/formula/classification are data-driven; external marks a proprietary score shown as structure only; builtin names a code-backed tool (see `tool`) whose behavior lives in a tested engine on both clients, with every user-facing string still in `toolContent`."
    },
    "tool": {
      "type": "string",
      "enum": [
        "ekg-axis"
      ],
      "description": "engine=builtin only: which code-backed tool renders this module. ekg-axis → web/src/lib/axisEngine.js + ios/Sources/Calc/AxisEngine.swift, parity-tested against tools/fixtures/axis-golden-vectors.json."
    },
    "toolContent": {
      "$ref": "#/$defs/ekgAxisContent",
      "description": "engine=builtin only: all copy the tool displays. The engine returns keys (category, flag, warning, status); this object maps each key to text."
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ED",
          "ICU",
          "OR",
          "Anesthesia"
        ]
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "notes": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "description": "Named values the user supplies. Used by engine=formula and referenced by item.showIf.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "boolean",
              "select"
            ]
          },
          "unit": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {}
              }
            }
          }
        }
      }
    },
    "items": {
      "description": "engine=additive: each item contributes points from the chosen option.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "options"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "points"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "points": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "formulas": {
      "description": "engine=formula: one or more named results.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "expression"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "expression": {
            "type": "string",
            "description": "Whitelisted grammar: numbers, input keys, + - * / ^ ( ), and sqrt()/cbrt()/abs()/min()/max()/ln()."
          },
          "unit": {
            "type": "string"
          },
          "precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "tiers": {
      "description": "engine=classification: ordered clinical tiers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mortality": {
            "type": "string"
          }
        }
      }
    },
    "interpretation": {
      "type": "array",
      "minItems": 1,
      "description": "Result bands. For additive: min/max score range. For formula: reference the formula key. For classification/external: descriptive only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "forKey": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "moderate",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional 2-D plot rendered alongside the result (e.g. a treatment nomogram). Curve expressions use the free variable `x`; the plotted point is taken from the inputs named by x.key / y.key.",
      "required": [
        "kind",
        "x",
        "y",
        "curves"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "semilogy"
          ]
        },
        "caption": {
          "type": "string"
        },
        "x": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "min",
            "max"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "y": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "min",
            "max"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "curves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "expression"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "expression": {
                "type": "string"
              },
              "tone": {
                "type": "string",
                "enum": [
                  "accent",
                  "muted",
                  "danger"
                ]
              }
            }
          }
        }
      }
    },
    "buildNote": {
      "type": "string",
      "description": "Guidance for whoever finalizes this — verification tasks, licensing, source-of-truth pointers."
    }
  },
  "$defs": {
    "ekgAxisContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "modifiers",
        "qrsCategories",
        "pCategories",
        "tCategories",
        "qrsTCategories",
        "flags",
        "warnings",
        "statusMessages",
        "checklists",
        "differentials",
        "peds",
        "clinicalTakeaway",
        "whyThisMatters"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "help"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "engineMode": {
                "type": "string",
                "enum": [
                  "prt",
                  "polarity",
                  "amplitudes"
                ]
              },
              "default": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "help": {
                "type": "string"
              },
              "leads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "I",
                    "II",
                    "III",
                    "aVR",
                    "aVL",
                    "aVF"
                  ]
                }
              }
            }
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "lbbb",
                  "rbbb",
                  "paced",
                  "lvh",
                  "wpw",
                  "wideQrs"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "qrsCategories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "range": {
                "type": "string"
              }
            }
          }
        },
        "pCategories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "tCategories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "qrsTCategories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "text"
            ],
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "warning",
                  "info"
                ]
              },
              "text": {
                "type": "string"
              },
              "checklist": {
                "type": "string"
              }
            }
          }
        },
        "warnings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "statusMessages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors"
          ],
          "properties": {
            "inconsistent": {
              "type": "string"
            },
            "ambiguous": {
              "type": "string"
            },
            "indeterminate": {
              "type": "string"
            },
            "need_two_leads": {
              "type": "string"
            },
            "no_input": {
              "type": "string"
            },
            "errors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "checklists": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "items"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "caveat": {
                "type": "string"
              }
            }
          }
        },
        "differentials": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "peds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bands",
            "note"
          ],
          "properties": {
            "bands": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "range"
                ],
                "properties": {
                  "age": {
                    "type": "string"
                  },
                  "range": {
                    "type": "string"
                  }
                }
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "clinicalTakeaway": {
          "type": "string"
        },
        "whyThisMatters": {
          "type": "string"
        }
      }
    }
  }
}
