{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/calculator.schema.json",
  "title": "Kairos calculator module",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/recordMeta" },
    { "$ref": "common.schema.json#/$defs/tieredReviewRequired" }
  ],
  "unevaluatedProperties": false,
  "required": ["engine", "purpose", "interpretation"],
  "properties": {
    "id": true, "section": true, "category": true, "title": true, "aliases": true, "tags": true, "keywords": true,
    "contentType": { "const": "calculator" },
    "content_version": true, "last_reviewed": true, "next_review_due": true,
    "review_tier": true, "sources": true, "changelog": true, "flags": true, "route": true,

    "engine": { "type": "string", "enum": ["additive", "formula", "classification", "external"] },
    "settings": {
      "type": "array",
      "items": { "type": "string", "enum": ["ED", "ICU", "OR", "Anesthesia"] }
    },
    "purpose": { "type": "string", "minLength": 10 },
    "notes": { "type": "string" },

    "inputs": {
      "type": "array",
      "description": "Named values the user supplies. Used by engine=formula and referenced by item.showIf.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["number", "integer", "boolean", "select"] },
          "unit": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": { "label": { "type": "string" }, "value": {} }
            }
          }
        }
      }
    },

    "items": {
      "description": "engine=additive: each item contributes points from the chosen option.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "options"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "help": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "points"],
              "properties": {
                "label": { "type": "string" },
                "points": { "type": "number" }
              }
            }
          }
        }
      }
    },

    "formulas": {
      "description": "engine=formula: one or more named results.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "expression"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "expression": {
            "type": "string",
            "description": "Whitelisted grammar: numbers, input keys, + - * / ^ ( ), and sqrt()/cbrt()/abs()/min()/max()/ln()."
          },
          "unit": { "type": "string" },
          "precision": { "type": "integer", "minimum": 0, "maximum": 6 }
        }
      }
    },

    "tiers": {
      "description": "engine=classification: ordered clinical tiers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "mortality": { "type": "string" }
        }
      }
    },

    "interpretation": {
      "type": "array",
      "minItems": 1,
      "description": "Result bands. For additive: min/max score range. For formula: reference the formula key. For classification/external: descriptive only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" },
          "forKey": { "type": "string" },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "risk": { "type": "string" },
          "disposition": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "moderate", "high", "critical"] }
        }
      }
    },

    "buildNote": {
      "type": "string",
      "description": "Guidance for whoever finalizes this — verification tasks, licensing, source-of-truth pointers."
    }
  }
}
