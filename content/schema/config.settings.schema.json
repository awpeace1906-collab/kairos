{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/config.settings.schema.json",
  "title": "Kairos care-setting config",
  "description": "The four care settings the app can be lensed to (Prehospital/Flight, ED, OR/Anesthesia, ICU/Critical Care). A setting reorders/emphasizes content — it never forks it. See DIRECTIONS_FORWARD.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["settings"],
  "properties": {
    "note": { "type": "string" },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 2 },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
