{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/search-index.schema.json",
  "title": "Kairos flat search index",
  "description": "GENERATED by tools/build-search-index.mjs. One flat array, not five. Search_TOC_Design_Spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "entries"],
  "properties": {
    "generatedAt": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "section", "category", "contentType", "route"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "type": "string" },
          "section": { "$ref": "common.schema.json#/$defs/section" },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "contentType": { "$ref": "common.schema.json#/$defs/contentType" },
          "route": { "type": "string" }
        }
      }
    }
  }
}
