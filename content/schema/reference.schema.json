{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/reference.schema.json",
  "title": "Kairos reference library module",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/recordMeta" },
    { "$ref": "common.schema.json#/$defs/tieredReviewRequired" }
  ],
  "unevaluatedProperties": false,
  "required": ["body"],
  "properties": {
    "id": true, "section": true, "category": true, "title": true, "aliases": true, "tags": true, "keywords": true,
    "contentType": { "const": "reference" },
    "content_version": true, "last_reviewed": true, "next_review_due": true,
    "review_tier": true, "sources": true, "changelog": true, "flags": true, "route": true,

    "summary": { "type": "string" },
    "body": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered content blocks. Markdown in text blocks; tables as row arrays.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["heading", "text", "list", "table", "callout"] },
          "level": { "type": "integer", "minimum": 2, "maximum": 4 },
          "text": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "tone": { "type": "string", "enum": ["info", "warning", "danger"] }
        }
      }
    },
    "related": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "buildNote": { "type": "string" }
  }
}
