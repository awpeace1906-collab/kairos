{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/config.sections.schema.json",
  "title": "Kairos sections config",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "coreQuestion", "contentType", "order", "categories"],
        "properties": {
          "id": { "type": "string", "enum": ["procedures", "calculators", "drug-dosing", "reference-library", "peds-module"] },
          "title": { "$ref": "common.schema.json#/$defs/section" },
          "coreQuestion": { "type": "string" },
          "contentType": { "$ref": "common.schema.json#/$defs/contentType" },
          "order": { "type": "integer", "minimum": 1, "maximum": 5 },
          "icon": { "type": "string", "description": "SF Symbol / icon name. Placeholder until the Tier 5 icon set is chosen." },
          "themeToken": { "type": "string", "description": "CSS/Swift color token name. Palette is an unresolved Tier 5 item — tokens only, no hex here." },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "title": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
