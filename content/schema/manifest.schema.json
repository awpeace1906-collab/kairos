{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/manifest.schema.json",
  "title": "Kairos content version manifest",
  "description": "GENERATED by tools/build-manifest.mjs. The lightweight file both clients poll. Version numbers + hashes only — never the content itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "schemaVersion", "modules"],
  "properties": {
    "generatedAt": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "contentBaseHint": { "type": "string", "description": "Informational: where a deploy is expected to serve this tree." },
    "modules": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+/[a-z0-9/_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_version", "hash", "path", "contentType", "section"],
          "properties": {
            "content_version": { "type": "integer", "minimum": 1 },
            "hash": { "type": "string", "description": "sha256 of the canonicalized JSON, first 16 hex chars." },
            "path": { "type": "string" },
            "contentType": { "$ref": "common.schema.json#/$defs/contentType" },
            "section": { "$ref": "common.schema.json#/$defs/section" },
            "review_tier": { "$ref": "common.schema.json#/$defs/reviewTier" },
            "next_review_due": { "$ref": "common.schema.json#/$defs/isoDate" }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
