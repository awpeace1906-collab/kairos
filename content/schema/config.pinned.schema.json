{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.app/schema/config.pinned.schema.json",
  "title": "Kairos home-screen pinned shortcuts",
  "description": "A short curated list of modules surfaced as one-tap cards on the home screen. Display order = array order. Keep it to 1-4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pinned"],
  "properties": {
    "$comment": { "type": "string" },
    "pinned": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 2 },
          "blurb": { "type": "string" }
        }
      }
    }
  }
}
