        },
        {
          "label": "2 — not intubated, irregular breathing",
          "points": 2
        },
        {
          "label": "1 — breathes above ventilator rate",
          "points": 1
        },
        {
          "label": "0 — breathes at ventilator rate or apnoea",
          "points": 0
        }
