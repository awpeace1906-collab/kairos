  "purpose": "Grades consciousness across four domains (Eye, Motor, Brainstem, Respiration), each 0–4. Unlike GCS it needs no verbal component, so it works in intubated patients, and it captures brainstem reflexes and breathing pattern — detecting locked-in syndrome, herniation, and brain death progression that GCS misses.",
  "items": [
    {
      "key": "eye",
      "label": "Eye response",
      "options": [
        {
          "label": "4 — eyelids open or opened, tracking, or blinking to command",
          "points": 4
        },
        {
          "label": "3 — eyelids open but not tracking",
          "points": 3
        },
        {
          "label": "2 — eyelids closed, open to loud voice",
          "points": 2
        },
        {
          "label": "1 — eyelids closed, open to pain",
          "points": 1
        },
        {
          "label": "0 — eyelids remain closed with pain",
          "points": 0
        }
      ]
    },
    {
      "key": "motor",
      "label": "Motor response",
      "options": [
        {
          "label": "4 — thumbs-up, fist, or peace sign to command",
          "points": 4
        },
        {
          "label": "3 — localising to pain",
          "points": 3
        },
        {
          "label": "2 — flexion response to pain",
          "points": 2
        },
        {
          "label": "1 — extension response to pain",
          "points": 1
        },
        {
          "label": "0 — no response to pain, or generalised myoclonus status",
          "points": 0
        }
      ]
    },
    {
      "key": "brainstem",
      "label": "Brainstem reflexes",
      "options": [
        {
          "label": "4 — pupil and corneal reflexes present",
          "points": 4
        },
        {
          "label": "3 — one pupil wide and fixed",
          "points": 3
        },
        {
          "label": "2 — pupil OR corneal reflex absent",
          "points": 2
        },
        {
          "label": "1 — pupil AND corneal reflexes absent",
          "points": 1
        },
        {
          "label": "0 — absent pupil, corneal, AND cough reflex",
          "points": 0
        }
      ]
    },
    {
      "key": "respiration",
      "label": "Respiration",
      "options": [
        {
          "label": "4 — not intubated, regular breathing pattern",
