  "interpretation": [
    { "min": 0, "max": 8, "label": "Minimal / mild withdrawal — reassess q4–8 h; generally no medication needed", "severity": "low" },
    { "min": 9, "max": 15, "label": "Moderate withdrawal — give a benzodiazepine dose (e.g. diazepam 10–20 mg or lorazepam 2–4 mg), reassess in 1 h", "severity": "moderate" },
    { "min": 16, "max": 67, "label": "Severe withdrawal — high risk of seizures / delirium tremens. Aggressive benzodiazepine loading (consider phenobarbital), frequent reassessment, monitored bed / ICU", "severity": "high" }
