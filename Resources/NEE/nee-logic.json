  "context_notes": [
    {
      "id": "ssc_vasopressin",
      "type": "info",
      "show_when_all": [
        {
          "agent": "norepinephrine",
          "canonical_dose_gte": {
            "num": 1,
            "den": 4
          }
        },
        {
          "agent": "vasopressin",
          "absent": true
        }
      ],
      "text": "SSC 2021: in septic shock with inadequate MAP on norepinephrine, adding vasopressin is suggested rather than escalating norepinephrine, typically at norepinephrine 0.25-0.5 mcg/kg/min. This threshold refers to norepinephrine base alone, not total NEE.",
      "citation_id": "ssc_2021"
    },
    {
      "id": "adjunct_note",
      "type": "info",
      "show_when_all": [
        {
          "adjunct_estimate_present": true
        }
      ],
      "text": "Adjunct estimates use Kotani 2023 factors, each derived from a single trial (hydroxocobalamin: 5 g lowered norepinephrine by 0.08 mcg/kg/min; midodrine: 30 mg/day lowered norepinephrine use by 73 mg over 6 days). Hydroxocobalamin is a one-time dose and midodrine is oral, so these estimates are shown for reference and are not added to NEE.",
      "citation_id": "kotani_2023"
    },
    {
      "id": "salt_note",
      "type": "static",
      "text": "Norepinephrine is sold as a salt. US labels state base-equivalent content (e.g., 16 mcg/mL base supplied as 31.9 mcg/mL bitartrate). Some countries label by salt weight, which doubles the apparent dose. Doses here are counted as base.",
      "citation_id": "salt_sources"
    },
    {
      "id": "disclaimer",
      "type": "static",
      "text": "NEE describes total vasopressor load for severity grading and research comparison. Conversion factors come from limited, heterogeneous data, and published formulas disagree. Do not use NEE to convert one vasopressor dose into another or to titrate therapy. Formulas were derived in adults.",
      "citation_id": "kotani_2023"
    }
  ],
  "citations": {
    "kotani_2023": "Kotani Y, Di Gioia A, Landoni G, Belletti A, Khanna AK. An updated 'norepinephrine equivalent' score in intensive care as a marker of shock severity. Crit Care. 2023;27:29. doi:10.1186/s13054-023-04322-y. Correction: Crit Care. 2025;29:104. doi:10.1186/s13054-025-05250-9.",
    "goradia_2021": "Goradia S, Sardaneh AA, Narayan SW, Penm J, Patanwala AE. Vasopressor dose equivalence: a scoping review and suggested formula. J Crit Care. 2021;61:233-240.",
    "athos3_2017": "Khanna A, et al. Angiotensin II for the treatment of vasodilatory shock (ATHOS-3). N Engl J Med. 2017. Formula as tabulated in Kotani 2023, Table 1.",
    "ssc_2021": "Evans L, et al. Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021. Threshold as cited in Mongardon N, et al. Crit Care. 2023;27:62. doi:10.1186/s13054-023-04354-4.",
    "salt_sources": "Mongardon N, et al. Norepinephrine formulation for equivalent vasopressive score. Crit Care. 2023;27:62. SCCM/ESICM Joint Task Force. Position paper on the reporting of norepinephrine formulations in critical care. Crit Care Med. 2024;52(4):521-530. US norepinephrine bitartrate premix label (DailyMed/DrugCentral)."
  }
